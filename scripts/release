#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 <version>"
    echo "  e.g. $0 0.2.0"
    exit 1
}

[[ $# -ne 1 ]] && usage

VERSION="$1"

if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Error: version must be in X.Y.Z format (got: ${VERSION})"
    exit 1
fi

# Ensure we're on main and up to date
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "main" ]]; then
    echo "Error: must be on main branch (currently on ${BRANCH})"
    exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "Error: working tree has uncommitted changes"
    exit 1
fi

# Release notes come from CHANGELOG.md. Check before anything is bumped or
# pushed: the tag is what publishes, and a tag pushed without notes cannot be
# fixed by editing a file afterwards.
if ! grep -q "^## v${VERSION} " CHANGELOG.md; then
    echo "Error: CHANGELOG.md has no '## v${VERSION} <date>' entry"
    echo "  the release workflow publishes that section as the release notes"
    exit 1
fi

echo "Releasing v${VERSION}..."

# Bump version in Cargo.toml
sed -i.bak "s/^version = \".*\"/version = \"${VERSION}\"/" Cargo.toml
rm -f Cargo.toml.bak

# The man pages carry the version and date in their .TH header, which nothing
# derives from Cargo.toml -- bump them here so they cannot silently go stale a
# release or two behind the binary they document.
TODAY=$(date -u +%Y-%m-%d)
for man in contrib/man/*.1; do
    sed -i.bak \
        "s/^\(\.TH [^ ]* 1 \)\"[^\"]*\" \"ugpibd [^\"]*\"/\1\"${TODAY}\" \"ugpibd ${VERSION}\"/" \
        "${man}"
    rm -f "${man}.bak"
done

# Regenerate Cargo.lock
cargo check --quiet

# Commit only if anything changed (version may already be set)
git add Cargo.toml Cargo.lock contrib/man
if ! git diff --cached --quiet; then
    git commit -m "Release v${VERSION}"
    git push origin main
fi

git tag "v${VERSION}"
git push origin "v${VERSION}"

echo ""
echo "v${VERSION} tagged and pushed. GitHub Actions will build and publish the release."
echo "https://github.com/berg/ugpibd/releases/tag/v${VERSION}"
