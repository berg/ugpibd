[Unit]
Description=Portmap presence for ugpibd's VXI-11 core channel
Documentation=man:ugpibd-portmap(1)
Documentation=https://github.com/berg/ugpibd
# Ordering only, not a requirement: if rpcbind is coming up at boot, let it
# get there first so the probe sees it and picks cooperation. On systems
# without rpcbind these do nothing.
After=network.target rpcbind.service rpcbind.socket

[Service]
Type=exec
EnvironmentFile=-/etc/default/ugpibd
ExecStart=/usr/bin/ugpibd-portmap $UGPIBD_PORTMAP_OPTS
Restart=on-failure
RestartSec=2
DynamicUser=yes

# Serve mode binds port 111 itself; this is the one privilege granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Answers RPC lookups and touches nothing else: unlike ugpibd.service this
# can take the full sandbox, devices included.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
