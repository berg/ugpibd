[Unit]
Description=ugpibd portmapper sockets (port 111)
Documentation=man:ugpibd-portmap(1)
# rpcbind owns the same port; both cannot serve it. Conflicting here turns a
# silent bind race into an explicit systemd refusal.
Conflicts=rpcbind.socket rpcbind.service

[Socket]
# Order matters and is part of the contract with the binary: fd 3 is the TCP
# listener, fd 4 the UDP socket.
ListenStream=111
ListenDatagram=111
BindIPv6Only=default

[Install]
WantedBy=sockets.target
