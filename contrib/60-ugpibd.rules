# udev rules for USB-GPIB adapters driven by ugpibd.
#
# Installed by the ugpibd package as /usr/lib/udev/rules.d/60-ugpibd.rules.
# Do not edit this file: drop overrides in /etc/udev/rules.d/ instead, where
# they take precedence and survive package upgrades.
#
# Product ids are the full set ugpibd supports. The Agilent adapters appear
# under a pre-firmware id, get their firmware uploaded by ugpibd itself, then
# re-enumerate under the ready id -- so both ids must be matched here.
#
#   0957:0007  Agilent 82357A (pre-firmware)   0957:0107  82357A (ready)
#   0957:0518  Agilent 82357B (pre-firmware)   0957:0718  82357B (ready)
#   3923:709b  NI GPIB-USB-HS                  3923:7618  NI GPIB-USB-HS+
#   3923:725c  KUSB-488A                       3923:725d  MC-USB-488

# Device permissions. GROUP is the daemon's own group rather than plugdev, so
# running ugpibd as a service does not hand it every plugdev device on the box.
# TAG+="uaccess" additionally grants the user at the local console access, which
# is what makes running ugpibd by hand work without sudo.
SUBSYSTEM=="usb", ATTR{idVendor}=="0957", ATTR{idProduct}=="0007|0107|0518|0718", MODE="0660", GROUP="ugpibd", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3923", ATTR{idProduct}=="709b|7618|725c|725d", MODE="0660", GROUP="ugpibd", TAG+="uaccess"

# Optional autostart. These pull in ugpibd-hotplug.service, which starts the
# daemon only if UGPIBD_AUTOSTART=yes is set in /etc/default/ugpibd; otherwise
# it exits cleanly without touching ugpibd.service.
#
# SYSTEMD_WANTS is deliberately a Wants-style dependency, never BindsTo: the
# Agilent adapters disconnect and re-enumerate under a new product id as part
# of ugpibd's own firmware upload, and a binding dependency would kill the
# daemon mid-upload every time.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0957", ATTR{idProduct}=="0007|0107|0518|0718", TAG+="systemd", ENV{SYSTEMD_WANTS}="ugpibd-hotplug.service"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="3923", ATTR{idProduct}=="709b|7618|725c|725d", TAG+="systemd", ENV{SYSTEMD_WANTS}="ugpibd-hotplug.service"
