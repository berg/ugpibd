#!/bin/sh
set -e

case "$1" in
configure)
    echo "ugpibd-portmap installed; discovery is opt-in:" >&2
    echo "    systemctl enable --now ugpibd-portmap" >&2
    echo "  (registers with rpcbind when present, serves port 111 itself when not)" >&2
    ;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

# Register the unit without enabling it: discovery is opt-in via
# `systemctl enable --now ugpibd-portmap`, which picks its own mode.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        for unit in ugpibd-portmap.service; do
            deb-systemd-helper unmask "$unit" >/dev/null || true
            deb-systemd-helper update-state "$unit" >/dev/null || true
        done
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        if systemctl --quiet is-active ugpibd-portmap.service 2>/dev/null; then
            deb-systemd-invoke try-restart ugpibd-portmap.service >/dev/null || true
        fi
    fi
fi

exit 0
