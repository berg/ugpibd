#!/bin/sh
set -e

UGPIBD_USER=ugpibd
UGPIBD_GROUP=ugpibd

case "$1" in
configure)
    # The udev rule sets GROUP="ugpibd" on the adapter. If the group does not
    # exist when udev processes the rule, udev logs an error and silently falls
    # back to root ownership -- so the account must exist *before* the rules
    # are reloaded and triggered below.
    if ! getent group "$UGPIBD_GROUP" >/dev/null; then
        addgroup --system "$UGPIBD_GROUP"
    fi
    if ! getent passwd "$UGPIBD_USER" >/dev/null; then
        adduser --system --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin \
            --ingroup "$UGPIBD_GROUP" \
            --gecos "ugpibd USB-GPIB daemon" \
            "$UGPIBD_USER"
    fi

    if [ -x /bin/udevadm ] || [ -x /sbin/udevadm ]; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
        # Scoped to USB adds so an already-attached adapter picks up its new
        # permissions without a reboot, without re-triggering every device.
        udevadm trigger --subsystem-match=usb --action=add >/dev/null 2>&1 || true
    fi
    ;;

abort-upgrade | abort-remove | abort-deconfigure) ;;

*)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

# Register the units with deb-systemd-helper without enabling them: startup is
# opt-in via UGPIBD_AUTOSTART in /etc/default/ugpibd (udev-driven) or an
# explicit `systemctl enable ugpibd`. update-state records the unit so its
# symlinks are cleaned up on purge.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        for unit in ugpibd.service ugpibd-hotplug.service; do
            deb-systemd-helper unmask "$unit" >/dev/null || true
            deb-systemd-helper update-state "$unit" >/dev/null || true
        done
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # Pick up a changed ExecStart/hardening set on upgrade, but only if the
        # admin already had the daemon running.
        if systemctl --quiet is-active ugpibd.service 2>/dev/null; then
            systemctl --system try-restart ugpibd.service >/dev/null || true
        fi
    fi
fi

exit 0
